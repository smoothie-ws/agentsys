[
  {
    "id": "ai",
    "title": "AI",
    "icon": "spark",
    "description": "Model provider configurations."
  },
  {
    "id": "providers",
    "parent": "ai",
    "title": "Providers",
    "icon": "server",
    "description": "Configure a provider, its endpoint and model catalog.",
    "item": {
      "name": "Provider",
      "format": "json",
      "fields": [
        {
          "key": "providerId",
          "label": "Provider ID",
          "type": "text",
          "format": "id",
          "required": true,
          "unique": true,
          "help": "Stable identifier used to address models as provider-id/model-id."
        },
        {
          "key": "npm",
          "label": "API adapter",
          "type": "select",
          "options": [
            "@ai-sdk/openai-compatible",
            "@ai-sdk/openai",
            "@ai-sdk/anthropic"
          ],
          "default": "@ai-sdk/openai-compatible"
        },
        {
          "key": "baseURL",
          "label": "Base URL",
          "type": "text",
          "format": "url",
          "required": true,
          "help": "The API endpoint, for example http://localhost:11434/v1."
        },
        {
          "key": "models",
          "label": "Models",
          "type": "list",
          "endpoint": "models",
          "help": "Loaded from the provider's Base URL /models endpoint."
        },
        {
          "key": "env",
          "label": "Credential environment variables",
          "type": "json",
          "shape": "array",
          "default": [],
          "help": "Ordered variable names, for example [\"PROVIDER_API_KEY\"]."
        },
        {
          "key": "headers",
          "label": "Additional headers",
          "type": "json",
          "shape": "object",
          "default": {}
        },
        {
          "key": "options",
          "label": "Provider options",
          "type": "json",
          "shape": "object",
          "default": {}
        },
        {
          "key": "apiKey",
          "label": "API key",
          "type": "secret",
          "help": "Stored separately. Leave empty to keep the saved key."
        }
      ]
    }
  }
]
