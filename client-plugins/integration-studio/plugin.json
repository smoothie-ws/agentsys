{
  "version": "1.0.0",
  "api": 2,
  "engines": {
    "agentsys": ">=0.3.0 <1.0.0"
  },
  "author": "AgentSys examples",
  "license": "MIT",
  "main": "main.js",
  "id": "integration-studio",
  "name": "Integration Studio",
  "description": "HTTP connections, server secrets, reusable Library stages and autonomous server workflows.",
  "icon": "globe",
  "capabilities": [
    "graph.read",
    "graph.write",
    "library.read",
    "library.write",
    "collections.read",
    "collections.write",
    "net.fetch:127.0.0.1:*",
    "secrets.use:integration-demo",
    "run.start"
  ],
  "contributes": {
    "collections": [
      {
        "name": "integration-connections",
        "title": "Integration connections",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "endpoint": {
              "type": "string",
              "maxLength": 2000
            },
            "parameters": {
              "type": "object"
            },
            "auth": {
              "type": "string",
              "enum": [
                "none",
                "bearer"
              ]
            },
            "secretName": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "name",
            "endpoint",
            "parameters",
            "auth",
            "secretName",
            "status"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "integration-results",
        "title": "Integration results",
        "schema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "object"
            }
          },
          "required": [
            "result"
          ],
          "additionalProperties": false
        }
      }
    ],
    "library": [
      {
        "name": "Integration: Read Configuration",
        "folder": "Integration Studio",
        "inputs": [],
        "outputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "grants": [
          "collections.read"
        ],
        "code": "const records = await agentsys('GET', 'collections/integration-connections/records'); const config = records.records[0]?.data; if (!config) throw Error('Create a connection first'); node.output.value = config;"
      },
      {
        "name": "Integration: HTTP Request",
        "folder": "Integration Studio",
        "inputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "outputs": [
          {
            "id": "value",
            "name": "value",
            "type": "t:64428b9c654c2c2cfcb55742ea899ed8"
          }
        ],
        "grants": [
          "net.fetch:127.0.0.1:*",
          "secrets.use:integration-demo"
        ],
        "code": "const config = node.input.value; if (!config) throw Error('Connect configuration'); let url = config.endpoint; const parameters = Object.entries(config.parameters || {}).map(([k,v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&'); if (parameters) url += (url.includes('?') ? '&' : '?') + parameters; const headers = config.auth === 'bearer' ? {Authorization: 'Bearer {{secret:' + config.secretName + '}}'} : {}; const answer = await agentsys('POST', 'net', {url, headers, timeout: 5000}); if (answer.status < 200 || answer.status >= 300) throw Error('HTTP ' + answer.status); node.output.value = answer.text;"
      },
      {
        "name": "Integration: JSON Parse",
        "folder": "Integration Studio",
        "inputs": [
          {
            "id": "value",
            "name": "value",
            "type": "t:64428b9c654c2c2cfcb55742ea899ed8"
          }
        ],
        "outputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "grants": [],
        "code": "node.output.value = JSON.parse(String(node.input.value));"
      },
      {
        "name": "Integration: Response Transform",
        "folder": "Integration Studio",
        "inputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "outputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "grants": [],
        "code": "const data = node.input.value; node.output.value = {ok: Boolean(data.ok), path: String(data.path || ''), received: Date.now()};"
      },
      {
        "name": "Integration: Store Result",
        "folder": "Integration Studio",
        "inputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "outputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "grants": [
          "collections.write"
        ],
        "code": "const made = await agentsys('POST', 'collections/integration-results/records', {data: {result: node.input.value}}); node.output.value = made.data.result;"
      },
      {
        "name": "Integration: Display Result",
        "folder": "Integration Studio",
        "inputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "outputs": [
          {
            "id": "value",
            "name": "value"
          }
        ],
        "grants": [],
        "code": "node.display(JSON.stringify(node.input.value)); node.output.value = node.input.value;"
      }
    ]
  }
}
